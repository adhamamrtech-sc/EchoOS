# Current Decision Engine provider (Gemini).
# Leave blank only if you are not exercising commands that require provider fallback.
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-3.6-flash
# Optional: GEMINI_TIMEOUT_SECONDS=20

# Audio / ASR settings
# Optional: ECHOOS_MIC=0
ECHOOS_WHISPER=large-v3-turbo
ECHOOS_LANG=auto
ECHOOS_DENOISE=0
